{
  "name": "secureflows",
  "version": "0.2.0",
  "description": "MCP server that wraps secureFlows ai-safe APIs, plus token-free tools that help an agent scaffold a correct integration.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "secureflows-mcp": "./bin/secureflows-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    ".claude-plugin",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "secureflows",
    "secure-flows",
    "mcp",
    "model-context-protocol",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michal-lefler/secureflows-mcp.git"
  },
  "homepage": "https://www.secure-flows.com",
  "bugs": {
    "url": "https://github.com/michal-lefler/secureflows-mcp/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/http-smoke.test.ts test/invoke-tool.test.ts test/json-schema.test.ts test/mirror-sync.test.ts test/plugin-distribution.test.ts test/resilience.test.ts test/security-review-prompt.test.ts test/select-operations.test.ts test/static-tools.test.ts",
    "test:live": "node --import tsx --test test/hosted-endpoint.live.test.ts",
    "generate:prompts": "node --import tsx scripts/generate-security-review.mjs",
    "prepack": "npm run build && node scripts/bundle-openapi.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "express": "^5.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  }
}
